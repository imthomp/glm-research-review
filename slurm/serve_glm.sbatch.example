#!/usr/bin/env bash
#SBATCH --job-name=glm-server
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:8
#SBATCH --time=24:00:00
#SBATCH --output=logs/serve-%j.out
#SBATCH --error=logs/serve-%j.err

set -euo pipefail

# Configure these values for your cluster.
MODEL_DIR=${MODEL_DIR:?Set MODEL_DIR to the downloaded GLM checkpoint}
SERVED_MODEL_NAME=${SERVED_MODEL_NAME:-glm-5.3}
PORT=${PORT:-8000}
TENSOR_PARALLEL_SIZE=${TENSOR_PARALLEL_SIZE:-8}

mkdir -p logs
hostname > server_node.txt

python -m vllm.entrypoints.openai.api_server \
  --model "$MODEL_DIR" \
  --served-model-name "$SERVED_MODEL_NAME" \
  --host 0.0.0.0 \
  --port "$PORT" \
  --tensor-parallel-size "$TENSOR_PARALLEL_SIZE" \
  --max-model-len 65536 \
  --gpu-memory-utilization 0.90 \
  --kv-cache-dtype fp8 \
  --trust-remote-code
